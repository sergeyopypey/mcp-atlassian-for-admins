{
  "name": "jira-dc-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Jira Data Center 10 introspection (TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jira-dc-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "selftest": "tsx test/selftest.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xmldom/xmldom": "^0.9.6",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
