{
  "name": "mcp-atlassian-for-admins",
  "version": "0.1.0",
  "description": "Read-only MCP server for deep Jira Data Center 10 introspection — 76 tools for admins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeyopypey/mcp-atlassian-for-admins.git"
  },
